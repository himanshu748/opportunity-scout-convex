VITE_CONVEX_URL=
# Set the following on the Convex deployment, never as VITE_ variables:
# OPENAI_API_KEY
# OPENAI_MODEL=openai/gpt-4.1-mini
# FIRECRAWL_API_KEY
# AGENTMAIL_API_KEY
# AGENTMAIL_INBOX_ID
# AGENTMAIL_WEBHOOK_SECRET
# CONVEX_ADMIN_KEY (needed for Mastra's ConvexStore)
# SITE_URL
# JWT_PRIVATE_KEY and JWKS (generated by Convex Auth setup)

# AI_GATEWAY_API_KEY (optional alternative to direct OpenAI)
# SCOUT_EMAIL_ENABLED=true
# SCOUT_EMAIL_POLLING=true
# SCOUT_TEST_RECIPIENT (only an explicitly authorized test address)
